{
  "name": "cheetor",
  "version": "0.13.1",
  "description": "Build interactive command line tools",
  "license": "MIT",
  "author": {
    "name": "Eric Chen"
  },
  "keywords": [
    "builder",
    "cheetor",
    "cli",
    "helper",
    "utils",
    "yargs"
  ],
  "homepage": "https://www.npmjs.com/package/cheetor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airkro/cheetor.git"
  },
  "bugs": {
    "url": "https://github.com/airkro/cheetor/issues"
  },
  "main": "index.mjs",
  "exports": "./index.mjs",
  "files": [
    "lib.mjs"
  ],
  "type": "module",
  "scripts": {
    "fmt:prettier": "prettier -w .",
    "lint:eslint": "eslint . --quiet --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "prepare": "nice-move git hooks",
    "prepublishOnly": "pnpm run lint:staged && pnpm run lint:type && pnpm test",
    "snapshot": "ava --fail-fast -u",
    "test": "ava --fail-fast"
  },
  "dependencies": {
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@bring-it/npm": "^0.9.6",
    "@nice-move/all-in-base": "^0.9.1",
    "ava": "^8.0.1",
    "eslint": "^10.9.1",
    "garou": "^0.9.21",
    "prettier": "~3.9.6",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=16.13.0 || ^14.17.0",
    "pnpm": "^10.33.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "ava": {
    "extensions": [
      "mjs"
    ]
  },
  "prettier": "@nice-move/prettier-config"
}
