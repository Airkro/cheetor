{
  "name": "cheetor",
  "version": "0.14.2",
  "description": "Build interactive command line tools",
  "license": "MIT",
  "author": {
    "name": "Eric Chen"
  },
  "keywords": [
    "builder",
    "cac",
    "cheetor",
    "cli",
    "helper",
    "utils"
  ],
  "homepage": "https://www.npmjs.com/package/cheetor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Airkro/cheetor.git"
  },
  "bugs": {
    "url": "https://github.com/Airkro/cheetor/issues"
  },
  "main": "dist/index.mjs",
  "exports": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt:prettier": "prettier -w .",
    "lint:eslint": "eslint . --quiet --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "prepare": "nice-move git hooks",
    "prepublishOnly": "pnpm run lint:eslint && pnpm run lint:type && pnpm test && pnpm build",
    "snapshot": "vitest run -u",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cac": "^7.0.0"
  },
  "devDependencies": {
    "@bring-it/npm": "^0.9.6",
    "@nice-move/all-in-base": "^0.9.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "garou": "^0.9.22",
    "prettier": "~3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^10.34.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": "@nice-move/prettier-config"
}
